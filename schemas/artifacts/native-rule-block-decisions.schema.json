{
  "schemaVersion": "1.0.0",
  "artifactType": "native_rule_block_decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "project_binding",
    "goal_digest",
    "project_fact_digest",
    "guidance_digest",
    "authority_inventory_digest",
    "source_revision",
    "decisions",
    "boundary",
    "decision_digest"
  ],
  "properties": {
    "schema_version": { "type": "string", "enum": ["1.0.0"] },
    "artifact_type": { "type": "string", "enum": ["native_rule_block_decisions"] },
    "project_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical_root", "topology_digest", "identity_kind", "identity_fingerprint"],
      "properties": {
        "canonical_root": { "type": "string", "minLength": 1 },
        "topology_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "identity_kind": { "type": "string", "minLength": 1 },
        "identity_fingerprint": { "type": "string", "minLength": 1 }
      }
    },
    "goal_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "project_fact_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "guidance_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "authority_inventory_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "source_revision": { "type": "string", "minLength": 1 },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["block_id", "block_digest", "source_file", "disposition", "reason"],
        "properties": {
          "block_id": { "type": "string", "pattern": "^NB-[a-f0-9]{24}-[1-9][0-9]*$" },
          "block_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "source_file": { "type": "string", "minLength": 1 },
          "disposition": { "type": "string", "enum": ["PRESERVE_AS_CONTEXT", "RESOLVED_NON_RULE", "CLASSIFY_AS_RULE"] },
          "reason": { "type": "string", "minLength": 1 },
          "classification": {
            "type": "object",
            "additionalProperties": false,
            "required": ["rule_class", "authority", "default_handling", "preserve_or_replace", "reason", "risk_surfaces", "target_action", "confidence"],
            "properties": {
              "rule_class": { "type": "string", "enum": ["BUSINESS_FACT", "PRODUCTION_CONTROL", "ENGINEERING_BASELINE", "WORKFLOW_RULE", "HISTORICAL_NOTE", "UNKNOWN_AUTHORITY"] },
              "authority": { "type": "string", "minLength": 1 },
              "default_handling": { "type": "string", "minLength": 1 },
              "preserve_or_replace": { "type": "string", "minLength": 1 },
              "reason": { "type": "string", "minLength": 1 },
              "risk_surfaces": { "type": "string", "minLength": 1 },
              "target_action": { "type": "string", "minLength": 1 },
              "confidence": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] }
            }
          }
        },
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "CLASSIFY_AS_RULE" } } },
            "then": { "required": ["classification"] },
            "else": { "not": { "required": ["classification"] } }
          }
        ]
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["writes_target_files", "authorizes_apply", "authorizes_activation", "authorizes_release_or_production"],
      "properties": {
        "writes_target_files": { "type": "string", "enum": ["No"] },
        "authorizes_apply": { "type": "string", "enum": ["No"] },
        "authorizes_activation": { "type": "string", "enum": ["No"] },
        "authorizes_release_or_production": { "type": "string", "enum": ["No"] }
      }
    },
    "decision_digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
  }
}
